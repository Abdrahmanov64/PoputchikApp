<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Создание новой поездки (Водитель)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNewFrom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Откуда (напр. Москва)"/>

    <EditText
        android:id="@+id/etNewTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Куда (напр. Тверь)"/>

    <EditText
        android:id="@+id/etNewDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Дата (нажмите для выбора)"
        android:focusable="false"
        android:clickable="true"
        android:inputType="none"/>

    <EditText
        android:id="@+id/etNewPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Цена (напр. 500)"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnSaveTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Опубликовать поездку"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnBackToRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вернуться к выбору роли"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/etNewSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Свободных мест (напр. 3)"
        android:inputType="number"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnDriverTrips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Мои поездки (заявки)"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnMyPassengers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Мои пассажиры (Отзывы)"
        android:layout_marginTop="10dp"/>

</LinearLayout>